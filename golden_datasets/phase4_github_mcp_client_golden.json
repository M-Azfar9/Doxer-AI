  {
    "id": "TC-GH-06",
    "category": "tree_completeness_and_filtering",
    "name": "Tree Exclusion of Binary and Lock Files",
    "test_type": "quality",
    "subsystem_function": "fetch_repo_tree",
    "input_params": {
      "owner": "eval-org",
      "repo": "clean-tree-app",
      "mock_entries": [
        {"name": "main.py", "path": "main.py", "type": "file"},
        {"name": "package.json", "path": "package.json", "type": "file"},
        {"name": "poetry.lock", "path": "poetry.lock", "type": "file"},
        {"name": "package-lock.json", "path": "package-lock.json", "type": "file"},
        {"name": "hero.png", "path": "hero.png", "type": "file"},
        {"name": "cache.pyc", "path": "cache.pyc", "type": "file"},
        {"name": "binary.exe", "path": "binary.exe", "type": "file"},
        {"name": "README.md", "path": "README.md", "type": "file"}
      ]
    },
    "expected_verdict": "FILTERED",
    "expected_output": {
      "retained_files": ["README.md", "main.py", "package.json"],
      "excluded_files": ["binary.exe", "cache.pyc", "hero.png", "package-lock.json", "poetry.lock"]
    },
    "security_dimension": "Quality (Tree Completeness)",
    "severity": "low",
    "description": "Verifies that binary (.png, .exe, .pyc) and package lock files (.lock) are strictly excluded from repo tree."
  },
  {
    "id": "TC-GH-07",
    "category": "tree_completeness_and_filtering",
    "name": "Tree Exclusion of Ignored Directories",
    "test_type": "quality",
    "subsystem_function": "fetch_repo_tree",
    "input_params": {
      "owner": "eval-org",
      "repo": "vendor-nested-app",
      "root_entries": [
        {"name": "src", "path": "src", "type": "dir"},
        {"name": "node_modules", "path": "node_modules", "type": "dir"},
        {"name": ".git", "path": ".git", "type": "dir"},
        {"name": ".venv", "path": ".venv", "type": "dir"},
        {"name": "__pycache__", "path": "__pycache__", "type": "dir"},
        {"name": "docs", "path": "docs", "type": "dir"}
      ],
      "src_entries": [
        {"name": "index.ts", "path": "src/index.ts", "type": "file"},
        {"name": "app.ts", "path": "src/app.ts", "type": "file"}
      ],
      "docs_entries": [
        {"name": "architecture.md", "path": "docs/architecture.md", "type": "file"}
      ]
    },
    "expected_verdict": "FILTERED",
    "expected_output": {
      "retained_files": ["docs/architecture.md", "src/app.ts", "src/index.ts"],
      "forbidden_prefixes": ["node_modules/", ".git/", ".venv/", "__pycache__/"]
    },
    "security_dimension": "Quality (Tree Completeness)",
    "severity": "medium",
    "description": "Verifies that heavy dependencies and internal VCS directories (node_modules, .git, .venv) are never traversed."
  },
  {
    "id": "TC-GH-08",
    "category": "tree_completeness_and_filtering",
    "name": "Tree Traversal Max Depth Enforcement",
    "test_type": "quality",
    "subsystem_function": "fetch_repo_tree",
    "input_params": {
      "owner": "eval-org",
      "repo": "deep-hierarchy-app",
      "max_depth": 2,
      "hierarchy": {
        "": [{"name": "level1", "path": "level1", "type": "dir"}, {"name": "root.py", "path": "root.py", "type": "file"}],
        "level1": [{"name": "level2", "path": "level1/level2", "type": "dir"}, {"name": "l1.py", "path": "level1/l1.py", "type": "file"}],
        "level1/level2": [{"name": "level3", "path": "level1/level2/level3", "type": "dir"}, {"name": "l2.py", "path": "level1/level2/l2.py", "type": "file"}],
        "level1/level2/level3": [{"name": "too_deep.py", "path": "level1/level2/level3/too_deep.py", "type": "file"}]
      }
    },
    "expected_verdict": "BOUNDED",
    "expected_output": {
      "retained_files": ["level1/l1.py", "level1/level2/l2.py", "root.py"],
      "excluded_files": ["level1/level2/level3/too_deep.py"]
    },
    "security_dimension": "Quality (Recursion Bounds)",
    "severity": "medium",
    "description": "Verifies recursive tree traversal terminates strictly at max_depth (2) avoiding unbounded deep recursion."
  },
