    "security_dimension": "Safety (Authentication Hygiene)",
    "severity": "high",
    "description": "Verifies that GitHub Authorization headers follow GitHub API v3 standards and do not leak via default __repr__."
  },
  {
    "id": "TC-GH-15",
    "category": "api_token_masking_and_security",
    "name": "Graceful Resilience on 404 Not Found",
    "test_type": "safety",
    "subsystem_function": "fetch_file_content",
    "input_params": {
      "owner": "eval-org",
      "repo": "nonexistent-repo",
      "file_path": "missing.py",
      "simulated_error": "HTTP Error 404: Not Found"
    },
    "expected_verdict": "HANDLED",
    "expected_output": {
      "graceful_return": true,
      "truncated": false,
      "error_prefix": "[Error reading file:"
    },
    "security_dimension": "Safety (Operational Resilience)",
    "severity": "medium",
    "description": "Ensures that 404 Not Found or missing repository errors are captured gracefully without unhandled process termination."
  }
