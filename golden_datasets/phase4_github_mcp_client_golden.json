  {
    "id": "TC-GH-13",
    "category": "api_token_masking_and_security",
    "name": "API Token Masking in Exception Messages",
    "test_type": "safety",
    "subsystem_function": "fetch_file_content",
    "input_params": {
      "token": "ghp_SUPER_SECRET_TOKEN_XYZ9876543210",
      "owner": "eval-org",
      "repo": "private-repo",
      "file_path": "secrets.py",
      "simulated_error": "urllib.error.HTTPError: 401 Unauthorized for token ghp_SUPER_SECRET_TOKEN_XYZ9876543210"
    },
    "expected_verdict": "MASKED",
    "expected_output": {
      "token_leaked": false,
      "token_redacted": true
    },
    "security_dimension": "Safety (Credential Confidentiality)",
    "severity": "critical",
    "description": "Verifies that GITHUB_ACCESS_TOKEN is never reflected in file error strings, exceptions, or diagnostic messages."
  },
  {
    "id": "TC-GH-14",
